# Copy to .env.local for local development. Never commit real values.

# Public site URL (canonical links, sitemap, Open Graph)
SITE_URL=https://shilan.co.il

# Rates provider: "mock" | "bank-of-israel" (wired in step 4)
RATES_PROVIDER=mock

# ---- Admin panel (/admin) ----
# The single site-owner login. Set the same values in Vercel > Settings > Environment Variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: signs the session cookie. If empty, a key is derived from the password.
ADMIN_SESSION_SECRET=

# ---- Vercel Blob (blog posts and images) ----
# On Vercel, connecting the Blob store to the project sets BLOB_STORE_ID automatically.
# Locally, either run `vercel env pull apps/web/.env.development.local`, or set a read-write token:
# BLOB_READ_WRITE_TOKEN=
# Without either, development stores posts in apps/web/.data (production requires Blob).

# ---- Customer accounts (Firebase Auth + Firestore) ----
# Firebase console > Project settings > General: "Web API key"
FIREBASE_API_KEY=
# Firebase console > Project settings > Service accounts > Generate new private key (JSON):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value; keep the \n sequences, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# Google sign-in: Google Cloud console > APIs & Services > Credentials (OAuth client).
# Authorized redirect URIs: https://<your-domain>/api/auth/google/callback and
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password-reset emails (resend.com). Without it, development prints the reset link to the server log.
RESEND_API_KEY=
EMAIL_FROM="שילן שירותי המרה <no-reply@shilan.co.il>"

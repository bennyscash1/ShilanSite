# Copy to .env.local for local development. Never commit real values.

# Public site URL (canonical links, sitemap, Open Graph)
SITE_URL=https://shilan.co.il

# Rates provider: "mock" | "bank-of-israel" (wired in step 4)
RATES_PROVIDER=mock

# ---- Admin panel (/admin) ----
# The single site-owner login. Set the same values in Vercel > Settings > Environment Variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: signs the session cookie. If empty, a key is derived from the password.
ADMIN_SESSION_SECRET=

# ---- Vercel Blob (blog posts and images) ----
# On Vercel, connecting the Blob store to the project sets BLOB_STORE_ID automatically.
# Locally, either run `vercel env pull apps/web/.env.development.local`, or set a read-write token:
# BLOB_READ_WRITE_TOKEN=
# Without either, development stores posts in apps/web/.data (production requires Blob).
